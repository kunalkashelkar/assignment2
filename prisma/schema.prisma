datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum RoleType {
  ADMIN
  MEMBER
  GUEST
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AuditEventType {
  USER_CREATED
  USER_LOGGED_IN
  ROLE_ASSIGNED
  ORGANIZATION_CREATED
  MEMBERSHIP_CREATED
  TRANSACTION_CREATED
  TRANSACTION_UPDATED
  TRANSACTION_DELETED
  EMAIL_DISPATCHED
  SECURITY_WARNING
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  OPENED
  CLICKED
}

// ---------------------------------------------------------
// RELATIONAL MODELS
// ---------------------------------------------------------

/// User model: Core identity record shared across tenants and Better Auth
model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth sessions and accounts
  sessions Session[]
  accounts Account[]

  // Normalized Relations
  memberships  Membership[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  emailEvents  EmailEvent[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

/// Organization / Tenant model: multi-tenant boundary
model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  Membership[]
  transactions Transaction[]

  @@index([slug])
  @@index([createdAt])
  @@map("organizations")
}

/// Role model: normalized role lookup
model Role {
  id          String   @id @default(uuid())
  name        RoleType @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@map("roles")
}

/// Membership model: junction table connecting User, Organization, and Role (CO3 Multi-tenancy)
model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([createdAt])
  @@map("memberships")
}

/// Transaction model: financial/business record scoped to User and Organization (CO4)
model Transaction {
  id             String            @id @default(uuid())
  organizationId String
  userId         String
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("USD")
  status         TransactionStatus @default(PENDING)
  description    String?
  reference      String            @unique
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

/// AuditLog model: immutable recording of security & transactional events
model AuditLog {
  id        String         @id @default(uuid())
  userId    String?
  eventType AuditEventType
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("audit_logs")
}

/// EmailEvent model: tracking transactional notifications and Resend lifecycle webhooks
model EmailEvent {
  id              String         @id @default(uuid())
  userId          String?
  emailId         String? // Resend message ID
  providerEventId String?        @unique // Resend webhook event ID for idempotency
  eventType       EmailEventType
  recipient       String
  subject         String?
  metadata        Json?
  createdAt       DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([emailId])
  @@index([providerEventId])
  @@index([eventType])
  @@index([createdAt])
  @@map("email_events")
}

// ---------------------------------------------------------
// BETTER AUTH SUPPORT MODELS
// ---------------------------------------------------------

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}
