# ==============================================================================
# Assignment 2 - Environment Variables Template
# Copy this file to .env and provide your local credentials.
# NEVER COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Prisma / PostgreSQL Connection URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/assignment2_db?schema=public"

# MongoDB / Mongoose Connection URI
# Format: mongodb://<HOST>:<PORT>/<DATABASE>
MONGODB_URI="mongodb://127.0.0.1:27017/assignment2_db"

# Better Auth Configuration
# Secret must be at least 32 characters long
BETTER_AUTH_SECRET="your_better_auth_secret_minimum_32_characters_long"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend Email Delivery
# Optional in local dev: when empty or placeholder, email sends are safely simulated locally
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_signing_secret"
EMAIL_FROM="onboarding@resend.dev"
